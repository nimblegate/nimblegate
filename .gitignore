.env
.env.local
.env.*.local

# Private/internal notes (dogfood logs, parked-ideas brain dumps, pre-launch
# scratch). These live in the working tree but stay out of the public repo.
.private/

# Generated demo static snapshot (rebuild with deploy/demo/static-build.sh)
/deploy/demo-static/

# Internal-only - kept locally for development, never published. (.private/ above
# covers scratch notes; these are the other dev-history artifacts that must not
# reach the public mirror.)
/CLAUDE.md
/BUSINESS-MODEL.md
/docs/sketches/
/docs/manual-tests/
/docs/superpowers/
/.superpowers/
/.claude/
.appframes/_design.md
.appframes/_future.md

# Internal working documents. Reachable only by browsing the repo (nothing links
# them), and each is a dev-history artifact rather than an operator reference:
# a roadmap for an unreleased version, a stale test-suite report, a session trace
# describing a shipped feature as once-unwired, and a commercial strategy memo.
/docs/v0.5-candidates.md
/docs/test-suite-findings.md
/docs/auto-pr-implementation-notes.md
/docs/positioning.md

# transient binary built by the relay boundary test
/deploy/gateway/relay-boundary-test/nimblegate
